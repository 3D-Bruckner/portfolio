{
  "name": "upload",
  "version": "0.0.0",
  "description": "Where 3dbruckner.de's prints are put in: their photos and details, from the phone or through Claude.",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate": "node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.21",
    "@better-auth/cimd": "1.7.21",
    "@better-auth/core": "1.7.21",
    "@better-auth/mcp": "1.7.21",
    "@better-auth/oauth-provider": "1.7.21",
    "@better-auth/passkey": "1.7.21",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.21",
    "better-sqlite3": "13.0.3",
    "kysely": "0.29.8",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "next-app-kit": "https://github.com/Marceltov/next-app-kit/releases/download/v0.1.4/next-app-kit-0.1.4.tgz",
    "nodemailer": "10.5.0",
    "pino": "^10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
