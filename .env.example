# portfolio's settings. Copy to .env, fill in, chmod 600, and keep each value in the password manager too.
# A commented line keeps the image's default; uncomment it only to change that.

# The public URL of the app: links in sign-in mails and MCP results, and the issuer of MCP tokens. Required.
PUBLIC_URL=https://portfolio.3dbruckner.de

# 32 or more random characters that sign sessions and tokens (openssl rand -base64 48). Required.
PORTFOLIO_SECRET=

# Who may sign in: addresses and @domain entries, comma-separated. Empty: nobody.
PORTFOLIO_ALLOWED_EMAILS=you@example.org

# Sign-in by email: a code (and a link) mailed through this SMTP server.
PORTFOLIO_SMTP_URL=smtps://user:password@smtp.example.org:465
PORTFOLIO_SMTP_FROM=3D Bruckner <noreply@3dbruckner.de>

# Sign-in providers besides the mail (next-app-kit): GITHUB, GOOGLE and APPLE are built in; any other OIDC provider needs its issuer.
# A block is valid only when complete, so it stays commented out until it is filled in.
# PORTFOLIO_OIDC_GITHUB_CLIENT_ID=
# PORTFOLIO_OIDC_GITHUB_CLIENT_SECRET=
# Any other provider, <NAME> its name in capitals (the button's name unless _LABEL is set):
# PORTFOLIO_OIDC_<NAME>_CLIENT_ID=
# PORTFOLIO_OIDC_<NAME>_CLIENT_SECRET=
# PORTFOLIO_OIDC_<NAME>_ISSUER=https://id.example.org/application/o/portfolio
# PORTFOLIO_OIDC_<NAME>_LABEL=

# A fine-grained GitHub token with "Actions: write" on the site's repository only: every change the site shows starts its build.
# Without it, nothing triggers the build.
PORTFOLIO_GITHUB_TOKEN=

# An app token for Thingiverse's API (thingiverse.com/developers): importing a print from a Thingiverse link needs it. MakerWorld and
# Printables need nothing.
PORTFOLIO_THINGIVERSE_TOKEN=

# print-bridge and portfolio's token there, which can read the average filament costs and nothing else: the print form shows what the
# filament cost and the margin. Without both, it says the cost is unavailable.
PORTFOLIO_BRIDGE_URL=
PORTFOLIO_BRIDGE_TOKEN=

# "Enhance with AI" on a print: Marcel's Claude gateway (https://claude.marceltov.de, Claude Code on his subscription for his own
# apps) and portfolio's bearer token there. Without both, the button isn't shown.
PORTFOLIO_CLAUDE_URL=
PORTFOLIO_CLAUDE_TOKEN=

# The site's repository and the workflow that builds it. Defaults: 3D-Bruckner/3dbruckner and pages.yml
# PORTFOLIO_SITE_REPO=3D-Bruckner/3dbruckner
# PORTFOLIO_SITE_WORKFLOW=pages.yml

# The site itself, for "On the website" links to a published print's page. Default: https://3dbruckner.de
# PORTFOLIO_SITE_URL=https://3dbruckner.de

# The largest photo an upload may send, in megabytes; a larger one is refused. What is stored is far smaller (long edge 2400 px,
# JPEG, no metadata). Default: 40
# PORTFOLIO_MAX_PHOTO_MB=40

# Where portfolio.sqlite, auth.sqlite and the photos live. Default in the image: /data
# DATA_DIR=/data

# The port the server listens on; it must be the real one, since /mcp and /api/v1 check tokens against the app's own key set at
# http://127.0.0.1:$PORT. Default in the image: 3000
# PORT=3000

# The time zone of the log's and the app's dates. Default: UTC
# TZ=Europe/Berlin

# A fixed person instead of signing in, for development. Refused when NODE_ENV=production, as in the image.
# PORTFOLIO_DEV_USER=you@example.org

# The log's level: debug, info, warn, error or silent. Default: info
# PORTFOLIO_LOG_LEVEL=info

# The owner of /data inside the container. Default: the owner of the mounted folder (1000 if that is root)
# PUID=1000
# PGID=1000

# A file of extra CA certificates (PEM) to trust besides the image's, e.g. an internal SMTP server's; mount the file into the container.
# NODE_EXTRA_CA_CERTS=/certs/internal-ca.pem

# 1 turns on the end-to-end tests' sign-in route (anyone on the allowlist signs in without a mail). Outside production only; never on a
# server.
# PORTFOLIO_E2E=1
